IREO_AUTO_RUN_ENABLED=false
IREO_AUTO_RUN_MAX_MESSAGES=3
IREO_AUTO_RUN_ALLOW_COPY=false
IREO_AUTO_RUN_REQUIRE_EXACT_MATCH=true
IREO_AUTO_RUN_NOTIFY_ON_SUCCESS=false
IREO_AUTO_RUN_BROWSER_MODE=review
# Modos aceitos: review, headless ou visible.
IREO_AUTO_RUN_START_DATE=
IREO_AUTO_RUN_DEBUG=false
